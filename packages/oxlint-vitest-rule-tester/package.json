    "@types/node": "^22.15.3",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@oxlint/plugins": ">=1.61.0",
    "oxlint": ">=1.61.0",
    "vitest": ">=2.0.0"
