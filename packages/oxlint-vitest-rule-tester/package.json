{
  "name": "oxlint-vitest-rule-tester",
  "version": "0.0.1",
  "description": "Vitest tester for Oxlint plugins",
  "keywords": [
    "oxlint",
    "vitest"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
